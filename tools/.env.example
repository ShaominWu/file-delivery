# Copy this file to tools/.env and fill in local secrets.

GMAIL_ADDRESS=your_email@example.com
GMAIL_APP_PASSWORD=your_gmail_app_password
GMAIL_IMAP_SERVER=imap.gmail.com

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SENDER_EMAIL=your_email@example.com
SENDER_PASSWORD=your_gmail_app_password
REPORT_TO=your_email@example.com

WATER_SENDERS=sender1@example.com,sender2@example.com
SAVE_FOLDER=~/Desktop/from Canada
SCAN_DAYS=7

TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

ENABLE_BROWSER_DOWNLOADS=0
